@using Alpha.Captcha.Mvc
@using Alpha.Captcha.Models
@{
    ViewBag.Title = "Simple Form Example";
    var captchaSetting = (CaptchaSetting)ViewData["CaptchaSetting"];
}
<h1>@ViewBag.Title</h1>
@Html.Captcha(captchaSetting)
@if ((Request.HttpMethod == "POST") && ViewData.ModelState.IsValid)
{
    <p class="success">Correct!</p>
}
<p class="error">
    @Html.ValidationSummary()
</p>