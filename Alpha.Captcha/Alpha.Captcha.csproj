<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <Description>MVC Captcha</Description>
    <Copyright>Starixsoft</Copyright>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl>https://gitlab.nexdev.net/rome/alpha/alpha.captcha</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<Deterministic>true</Deterministic>
    <AssemblyVersion>1.0.7</AssemblyVersion>
    <FileVersion>1.0.7</FileVersion>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mvc captcha</PackageTags>
    <Authors>Starixsoft</Authors>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.0.7</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\captcha.min.css">
		<DependentUpon>captcha.scss</DependentUpon>
	</EmbeddedResource>
	<None Update="Resources\captcha.ts">
      <Generator>TypeScriptCompile</Generator>
    </None>
	<None Include="Resources\captcha.js">
		<DependentUpon>captcha.ts</DependentUpon>
	</None>
    <EmbeddedResource Include="Resources\captcha.min.js">
		<DependentUpon>captcha.ts</DependentUpon>
	</EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.3" />
	<Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
	<EmbeddedResource Update="Resources\Lang.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Lang.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Lang.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Lang.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="compilerconfig.json.defaults">
		<DependentUpon>compilerconfig.json</DependentUpon>
	</None>
  </ItemGroup>
</Project>